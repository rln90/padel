{
  "name": "padel-turnier",
  "version": "0.1.0",
  "private": true,
  "description": "Padel-Turnier (Einzel, Schweizer System) mit Live-Ansicht",
  "scripts": {
    "build": "node tools/build.js",
    "test": "bash tests/run-all.sh",
    "build:server": "node tools/build-server.js",
    "test:server": "node tools/build-server.js --check && node tests/server/functional.test.mjs && node tests/server/sim.test.mjs 80 && SIM_WIDE=1 node tests/server/sim.test.mjs 60 && node tests/server/fuzz.test.mjs 40",
    "build:check": "node tools/build.js --check",
    "dev": "wrangler dev --local --port 8787 --var CREATE_KEY:geheim",
    "test:online": "node tests/online/ui-online.test.mjs yes && node tests/online/ui-online.test.mjs no && node tests/online/ui-online.test.mjs wait && node tests/online/ui-komfort.test.mjs",
    "test:e2e": "node tests/online/e2e.mjs",
    "test:audit": "node tests/online/audit.mjs",
    "test:csp": "node tests/online/csp.mjs",
    "test:probe": "node tests/online/generalprobe.mjs",
    "test:qr": "node tests/online/qr.mjs",
    "test:layout": "node tests/online/layout.mjs",
    "test:konsistenz": "node tests/online/konsistenz.mjs",
    "test:reihe": "node tests/online/reihe.mjs",
    "test:obskur": "node tests/online/obskur.mjs",
    "test:angriff": "node tests/online/angriff.mjs",
    "test:backup": "node tests/online/backup.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "jsqr": "^1.4.0",
    "wrangler": "^4.162.0"
  }
}
